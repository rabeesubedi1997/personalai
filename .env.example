# Copy this file to .env and adjust as needed. Never commit the real .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Phase 1 default: zero-install local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./personalops.db
# Production target (spec Section 27): PostgreSQL + pgvector. Switch by
# uncommenting this and pointing it at a running Postgres instance —
# no code changes required.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personalops

# --- Redis ---
# Optional in Phase 1. Leave unset/blank to run without Redis (caching and
# rate limiting just no-op); the app degrades gracefully either way.
REDIS_URL=redis://localhost:6379/0

# --- AI Provider ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Reserved for future providers (unused while AI_PROVIDER=ollama)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Auth ---
JWT_SECRET=change-me-in-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Agent execution limits ---
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_TOOL_TIMEOUT_SECONDS=30
